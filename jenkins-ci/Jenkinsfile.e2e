pipeline {
    agent any
    tools {
        go '1.23.2'
    }
    options {
        disableConcurrentBuilds()
        timeout(time: 10, unit: 'MINUTES')
    }

    environment {
        WEBHOOK_SECRET = credentials('bunsamosa-webhook-secret')
        CERT_FILE      = credentials('bunsamosa-private-key')
    }

    stages {
        stage('Prepare') {
            steps {
                // Checkout repos + setup secrets file
                dir('saturn') {
                    git url: 'https://github.com/acmpesuecc/saturn', branch: 'main'
                }
                checkout scm

                writeFile file: 'secrets-dev.yaml', text: '''certPath: $CERT_FILE
                webhookSecret: $WEBHOOK_SECRET
                appID: 1024499
                orgID: 183599010
                webServerPort: 4000
                dbPath: test.db
                timerDaemonURL: "http://localhost:3000"'''

                sh '''
                ls -l
                cat secrets-dev.yaml
                '''
            }
        }

        stage('Run & Test') {
            parallel {
                stage('Saturn Run') {
                    steps {
                        dir('saturn') {
                            sh '''
                            fuser -k 3000/tcp || true
                            go run . --webhook_url="http://localhost:4000"
                            '''
                        }
                    }
                }
                stage('Bunsamosa Run') {
                    steps {
                        sh '''
                        fuser -k 4000/tcp || true
                        BUNSAMOSA_DEV_MODE=1 JSON_LOG_DIR="logs" go run .
                        '''
                    }
                }
                stage('PingCheck') {
                    steps {
                        // Wait a bit for services, then call /ping
                        sh '''
                        sleep 60
                        curl -f http://localhost:4000/ping
                        '''
                    }
                }
            }
        }
    }
}
