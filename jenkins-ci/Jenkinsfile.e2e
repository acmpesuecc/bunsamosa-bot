pipeline {
    agent any
    tools {
        go '1.23.2'
    }
    options {
        disableConcurrentBuilds()
        timeout(time: 10, unit: 'MINUTES')
    }

    environment {
        WEBHOOK_SECRET = credentials('bunsamosa-webhook-secret')
        CERT_FILE      = credentials('bunsamosa-private-key')
    }

    stages {
        stage('Prepare') {
            steps {
                // Checkout repos + setup secrets file
                dir('saturn') {
                    git url: 'https://github.com/acmpesuecc/saturn', branch: 'main'
                }
                checkout scm

                script {
                    def content = """certPath: ${env.CERT_FILE}
webhookSecret: ${env.WEBHOOK_SECRET}
appID: 1024499
orgID: 183599010
webServerPort: 4000
dbPath: test.db
timerDaemonURL: "http://localhost:3000"
"""
                    writeFile file: 'secrets-dev.yaml', text: content
                }

                sh '''
                ls -l
                cat secrets-dev.yaml
                '''
            }
        }

        stage('Run & Test') {
            parallel {
                stage('Saturn Run') {
                    steps {
                        dir('saturn') {
                            sh '''
                            #!/bin/bash
                            fuser -k 3000/tcp || true
                            echo $$ > $WORKSPACE/saturn.pid & exec go run . --webhook_url="http://localhost:4000"
                            '''
                        }
                    }
                }
                stage('Bunsamosa Run') {
                    steps {
                        sh '''
                        fuser -k 4000/tcp || true
                        BUNSAMOSA_DEV_MODE=1 JSON_LOG_DIR="logs" go run . & echo $! > $WORKSPACE/bunsamosa.pid; wait $(cat $WORKSPACE/bunsamosa.pid) || true
                        '''
                    }
                }
                stage('PingCheck') {
                    steps {
                        // Wait a bit for services, then call /ping
                        sh '''
                        sleep 25
                        ps -p $(cat $WORKSPACE/saturn.pid)
                        ps -p $(cat $WORKSPACE/bunsamosa.pid)
                        curl -f http://localhost:4000/ping
                        '''
                    }
                    post {
                        always {
                            sh '''
                            while ps -p $(cat $WORKSPACE/saturn.pid); do kill -9 $(cat $WORKSPACE/saturn.pid); done
                            while ps -p $(cat $WORKSPACE/bunsamosa.pid); do kill -9 $(cat $WORKSPACE/bunsamosa.pid); done
                            sleep 5
                            '''
                        }
                    }
                }
            }
        }
    }
}
