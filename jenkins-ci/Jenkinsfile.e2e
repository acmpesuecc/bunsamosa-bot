pipeline {
    agent any
    tools {
        go '1.23.2'
    }
    options {
        disableConcurrentBuilds()
        timeout(time: 10, unit: 'MINUTES')
    }

    environment {
        WEBHOOK_SECRET = credentials('bunsamosa-webhook-secret')
        CERT_FILE      = credentials('bunsamosa-private-key')
    }

    stages {
        stage('Prepare') {
            steps {
                // Checkout repos + setup secrets file
                dir('saturn') {
                    git url: 'https://github.com/acmpesuecc/saturn', branch: 'main'
                }
                checkout scm

                script {
                    def content = """certPath: ${env.CERT_FILE}
webhookSecret: ${env.WEBHOOK_SECRET}
appID: 1024499
orgID: 183599010
webServerPort: 4000
dbPath: test.db
timerDaemonURL: "http://localhost:3000"
"""
                    writeFile file: 'secrets-dev.yaml', text: content
                }
            }
        }

        stage('Run & Test') {
            failFast true
            parallel {
                stage('Saturn Run') {
                    steps {
                        dir('saturn') {
                            sh '''
                            #!/bin/bash
                            fuser -k 3000/tcp || true
                            go run . --webhook_url="http://localhost:4000"
                            '''
                        }
                    }
                }
                stage('Bunsamosa Run') {
                    steps {
                        sh '''
                        rm -rf test.db
                        fuser -k 4000/tcp || true
                        BUNSAMOSA_DEV_MODE=1 JSON_LOG_DIR="logs" timeout 5 go run . || true
                        cat dev/init.sql | sqlite3 test.db
                        echo "select * from maintainers;" | sqlite3 test.db
                        BUNSAMOSA_DEV_MODE=1 JSON_LOG_DIR="logs" go run .
                        '''
                    }
                }
                stage('PingCheck') {
                    steps {
                        // Wait a bit for services, then call /ping
                        sh '''
                        sleep 10

                        logfile=/tmp/bore.log
                        bore local 4000 --to jenkins.smuz.me -s acm >"$logfile" 2>&1 &
                        bore_pid=$!
                        while ! grep -q "listening at jenkins.smuz.me:" "$logfile"; do
                          sleep 0.2
                        done
                        port=$(grep -oE 'listening at jenkins.smuz.me:[0-9]+' "$logfile" | tail -n1 | cut -d: -f2)
                        addr="jenkins.smuz.me:$port"

                        curl -f http://localhost:4000/ping
                        curl -f "http://$addr/ping"
                        '''

                        script {
                            currentBuild.getRawBuild().getExecutor().interrupt(Result.SUCCESS)
                            sleep(1)   // Interrupt is not blocking and does not take effect immediately.
                        }
                    }
                }
            }
        }
    }
}
