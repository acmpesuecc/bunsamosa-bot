pipeline {
    agent any

    environment {
        WEBHOOK_SECRET = credentials('bunsamosa-webhook-secret')
        CERT_FILE      = credentials('bunsamosa-private-key')
    }

    stages {
        stage('Prepare') {
            steps {
                // Checkout repos + setup secrets file
                dir('saturn') {
                    git url: 'https://github.com/acmpesuecc/saturn', branch: 'main'
                }
                checkout scm

                sh '''
                mkdir -p dev-temp
                cp "$CERT_FILE" dev-temp/ci-bunsamosabot.2025-08-27.private-key.pem

                cat > secrets-dev.yaml <<EOF
                certPath: dev-temp/ci-bunsamosabot.2025-08-27.private-key.pem
                webhookSecret: $WEBHOOK_SECRET
                appID: 1024499
                orgID: 183599010

                webServerPort: 4000
                dbPath: test.db
                timerDaemonURL: http://localhost:3000
                EOF
                '''
            }
        }

        stage('Run & Test') {
            parallel {
                stage('Saturn') {
                    steps {
                        dir('saturn') {
                            sh 'go run . --webhook_url="http://localhost:4000"'
                        }
                    }
                }
                stage('Bunsamosa') {
                    steps {
                        sh 'make ci'
                    }
                }
                stage('PingCheck') {
                    steps {
                        // Wait a bit for services, then call /ping
                        sh '''
                        sleep 20
                        curl -f http://localhost:4000/ping
                        '''
                    }
                }
            }
        }
    }
}
